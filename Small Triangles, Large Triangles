#include <stdio.h>
#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
long long get_squared_area(triangle t) {
    long long a = t.a;
    long long b = t.b;
    long long c = t.c;
    return (a + b + c) * (a + b - c) * (a - b + c) * (-a + b + c);
}
int compare_triangles(const void* a, const void* b) {
    long long area_a = get_squared_area(*(triangle*)a);
    long long area_b = get_squared_area(*(triangle*)b);
    
    if (area_a < area_b) return -1;
    if (area_a > area_b) return 1;
    return 0;
}

void sort_by_area(triangle* tr, int n) {
     qsort(tr, n, sizeof(triangle), compare_triangles);
}

int main()
{
	int n;
	scanf("%d", &n);
	triangle *tr = malloc(n * sizeof(triangle));
	for (int i = 0; i < n; i++) {
		scanf("%d%d%d", &tr[i].a, &tr[i].b, &tr[i].c);
	}
	sort_by_area(tr, n);
	for (int i = 0; i < n; i++) {
		printf("%d %d %d\n", tr[i].a, tr[i].b, tr[i].c);
	}
	return 0;
}
